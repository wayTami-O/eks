{"file":"register-BKzlWvHS.js","mappings":";;;;;;;;;;;;;;;;;AAUc,aAAA;AAEd,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,QAAQ,IAAI,EAAE;AAEpB,UAAM,SAAS,IAA4B,EAAE;AAC7C,UAAM,UAAU,IAAI,KAAK;;;;QA4ElB,OAAM;AAAA,QAAO,OAAA,EAAA,aAAA,SAAA,UAAA,SAAA;AAAA,MAAA,yCACZ,EAAA,UAAA,eAAA,aAAA,UAAA,CAA+C,iDAGhD,EAAA,UAAA,YAAA,SAAA,eAAA,CAA6C;AAEpC,YAAAA,mBAAA,qBAAA,EAAA,IAAG,YAAQ;AAAA,yBAArB,CAA4D,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAAtC,6BAA2B;AAAA,YAAA;AAAA;;;;oHAOpCC,MAAA,KAAA,CAAK,CAAA,oCAAA;AAIP,UAAAA,MAAA,MAAA,EAAO,OAAK;AAChB,cAAA,0BAAAC,eAAAD,MAAA,MAAA,EAAO,KAAK,CAAA,MAAA;AAAA;;;uHAONA,MAAA,QAAA,CAAQ,CAAA,wDAAA;AAKV,UAAAA,MAAA,MAAA,EAAO,UAAQ;AACnB,cAAA,0BAAAC,eAAAD,MAAA,MAAA,EAAO,QAAQ,CAAA,MAAA;AAAA;;;oHAKUA,MAAA,QAAA,CAAQ,CAAA,gCAAA;AAC7B,UAAAA,MAAA,MAAA,EAAO,UAAQ;AACnB,cAAA,0BAAAC,eAAAD,MAAA,MAAA,EAAO,QAAQ,CAAA,MAAA;AAAA;;;kHAOTA,MAAA,KAAA,CAAK,CAAA,8DAAA;AAKP,UAAAA,MAAA,MAAA,EAAO,OAAK;AAChB,cAAA,0BAAAC,eAAAD,MAAA,MAAA,EAAO,KAAK,CAAA,MAAA;AAAA;;;gHAONA,MAAA,KAAA,CAAK,CAAA,8CAAA;AAKP,UAAAA,MAAA,MAAA,EAAO,OAAK;AAChB,cAAA,0BAAAC,eAAAD,MAAA,MAAA,EAAO,KAAK,CAAA,MAAA;AAAA;;;yFAG2B,EAAA,SAAA,QAAmB,2BAAYA,MAAA,OAAA,CAAO,IAAA,cAAA;;;;;;;;;;","names":["_ssrRenderComponent","_push","_parent","_unref","_ssrInterpolate"],"sources":["../../../../pages/register.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport {\n  validateEmail,\n  validateFullName,\n  validateLogin,\n  validatePassword,\n  validatePhone,\n} from \"~/utils/validation\";\n\nconst resolveBase = useApiBase();\nconst toast = useToast();\n\nconst login = ref(\"\");\nconst password = ref(\"\");\nconst fullName = ref(\"\");\nconst phone = ref(\"\");\nconst email = ref(\"\");\n\nconst errors = ref<Record<string, string>>({});\nconst pending = ref(false);\n\ndefinePageMeta({\n  layout: \"default\",\n});\n\nfunction validateAll(): boolean {\n  const e: Record<string, string> = {};\n  const l = validateLogin(login.value.trim());\n  if (l) e.login = l;\n  const p = validatePassword(password.value);\n  if (p) e.password = p;\n  const f = validateFullName(fullName.value);\n  if (f) e.fullName = f;\n  const ph = validatePhone(phone.value.trim());\n  if (ph) e.phone = ph;\n  const em = validateEmail(email.value.trim());\n  if (em) e.email = em;\n  errors.value = e;\n  return Object.keys(e).length === 0;\n}\n\nasync function submit() {\n  if (!validateAll()) {\n    toast.push(\"Исправьте ошибки в полях\", \"error\");\n    return;\n  }\n  pending.value = true;\n  errors.value = {};\n  try {\n    const res = await $fetch<{\n      ok: boolean;\n      message?: string;\n      errors?: Record<string, string[]>;\n    }>(`${resolveBase()}/api/auth/register`, {\n      method: \"POST\",\n      body: {\n        login: login.value.trim(),\n        password: password.value,\n        fullName: fullName.value.trim(),\n        phone: phone.value.trim(),\n        email: email.value.trim(),\n      },\n    });\n    if (res.ok) {\n      toast.push(\"Пользователь создан. Теперь можно войти.\", \"success\");\n      await navigateTo(\"/login\");\n      return;\n    }\n    if (res.message) toast.push(res.message, \"error\");\n    if (res.errors) {\n      const flat: Record<string, string> = {};\n      for (const [k, v] of Object.entries(res.errors)) {\n        if (v?.[0]) flat[k] = v[0];\n      }\n      errors.value = flat;\n    }\n  } catch (e: unknown) {\n    const err = e as { data?: { message?: string; errors?: Record<string, string[]> } };\n    if (err?.data?.message) toast.push(err.data.message, \"error\");\n    if (err?.data?.errors) {\n      const flat: Record<string, string> = {};\n      for (const [k, v] of Object.entries(err.data.errors)) {\n        if (v?.[0]) flat[k] = v[0];\n      }\n      errors.value = flat;\n    } else {\n      toast.push(\"Не удалось создать пользователя\", \"error\");\n    }\n  } finally {\n    pending.value = false;\n  }\n}\n</script>\n\n<template>\n  <div class=\"card\" style=\"max-width: 520px; margin: 0 auto\">\n    <h1 style=\"margin: 0 0 0.35rem; font-size: 1.35rem\">\n      Регистрация\n    </h1>\n    <p style=\"margin: 0 0 1rem; color: var(--muted)\">\n      Все поля обязательны.\n      <NuxtLink to=\"/login\">Уже зарегистрированы? Войти</NuxtLink>\n    </p>\n    <form @submit.prevent=\"submit\">\n      <div class=\"field\">\n        <label for=\"login\">Логин</label>\n        <input\n          id=\"login\"\n          v-model=\"login\"\n          autocomplete=\"username\"\n          required\n        >\n        <p v-if=\"errors.login\" class=\"field-error\">\n          {{ errors.login }}\n        </p>\n      </div>\n      <div class=\"field\">\n        <label for=\"password\">Пароль</label>\n        <input\n          id=\"password\"\n          v-model=\"password\"\n          type=\"password\"\n          autocomplete=\"new-password\"\n          required\n        >\n        <p v-if=\"errors.password\" class=\"field-error\">\n          {{ errors.password }}\n        </p>\n      </div>\n      <div class=\"field\">\n        <label for=\"fullName\">ФИО</label>\n        <input id=\"fullName\" v-model=\"fullName\" autocomplete=\"name\" required>\n        <p v-if=\"errors.fullName\" class=\"field-error\">\n          {{ errors.fullName }}\n        </p>\n      </div>\n      <div class=\"field\">\n        <label for=\"phone\">Телефон</label>\n        <input\n          id=\"phone\"\n          v-model=\"phone\"\n          placeholder=\"8(999)123-45-67\"\n          inputmode=\"numeric\"\n          required\n        >\n        <p v-if=\"errors.phone\" class=\"field-error\">\n          {{ errors.phone }}\n        </p>\n      </div>\n      <div class=\"field\">\n        <label for=\"email\">Email</label>\n        <input\n          id=\"email\"\n          v-model=\"email\"\n          type=\"email\"\n          autocomplete=\"email\"\n          required\n        >\n        <p v-if=\"errors.email\" class=\"field-error\">\n          {{ errors.email }}\n        </p>\n      </div>\n      <button type=\"submit\" class=\"btn btn-primary\" style=\"width: 100%\" :disabled=\"pending\">\n        Создать пользователя\n      </button>\n    </form>\n  </div>\n</template>\n"],"version":3}