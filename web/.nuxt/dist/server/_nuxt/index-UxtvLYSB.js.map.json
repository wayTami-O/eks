{"file":"index-UxtvLYSB.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;AACA,UAAM,EAAE,cAAc,YAAA,IAAgB,UAAA;AAkBtC,UAAM,EAAE,IAAA,IAAQ,OAAA;AAChB,UAAM,QAAQ,SAAA;AAEd,UAAM,eAAe,IAAW,EAAE;AAClC,UAAM,OAAO,IAAI,CAAC;AAClB,UAAM,QAAQ,IAAI,CAAC;AACnB,UAAM,QAAQ,IAAI,CAAC;AACnB,UAAM,aAAa,IAAI,CAAC;AACxB,UAAM,eAAe,IAA8C,EAAE;AACrE,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,WAAW,IAAmB,IAAI;AAOxC,mBAAe,OAAO;AACpB,cAAQ,QAAQ;AAChB,UAAI;AACF,cAAM,IAA4B;AAAA,UAChC,MAAM,OAAO,KAAK,KAAK;AAAA,UACvB,OAAO,OAAO,MAAM,KAAK;AAAA,QAAA;AAE3B,YAAI,aAAa,MAAO,GAAE,SAAS,aAAa;AAChD,cAAM,MAAM,MAAM,IAMf,2BAA2B,EAAE,OAAO,GAAG;AAC1C,qBAAa,QAAQ,IAAI;AACzB,cAAM,QAAQ,IAAI;AAClB,mBAAW,QAAQ,IAAI;AACvB,aAAK,QAAQ,IAAI;AAAA,MACnB,QAAQ;AACN,cAAM,KAAK,+BAA+B,OAAO;AAAA,MACnD,UAAA;AACE,gBAAQ,QAAQ;AAAA,MAClB;AAAA,IACF;AAIA,UAAM,CAAC,MAAM,YAAY,GAAG,MAAM;AAChC,WAAK,KAAA;AAAA,IACP,CAAC;;uFAmCO,EAAA,UAAA,YAAA,aAAA,UAAA,CAA4C,kGAItB,EAAA,iBAAA,QAAA,WAAA,OAAA,CAA0C,iDAC7D,EAAA,WAAA,QAAA,OAAA,WAAA,aAAA,QAAA,eAAA,UAAyE,mDACrE,EAAA,WAAA,QAAA,kBAAA,UAAA,OAAA,WAAA,aAAA,WAAA,SAAA,gBAAoG,2JAExFA,MAAA,YAAA,CAAY,oBAAZA,MAAA,YAAA,GAAY,EAAA,kBAAZA,MAAA,YAAA,GAAY,EAAA,CAAA,IAAA,cAAA,2FAAZA,MAAA,YAAA,CAAY,oBAAZA,MAAA,YAAA,GAAY,KAAA,kBAAZA,MAAA,YAAA,GAAY,KAAA,CAAA,IAAA,cAAA,qGAAZA,MAAA,YAAA,CAAY,oBAAZA,MAAA,YAAA,GAAY,aAAA,kBAAZA,MAAA,YAAA,GAAY,aAAA,CAAA,IAAA,cAAA,2GAAZA,MAAA,YAAA,CAAY,oBAAZA,MAAA,YAAA,GAAY,WAAA,kBAAZA,MAAA,YAAA,GAAY,WAAA,CAAA,IAAA,cAAA,6GAeFA,MAAA,KAAA,CAAK;UAI7BA,MAAA,OAAA,GAAO;;;oEAIoB,EAAA,WAAA,KAAA,YAAA,SAAA,CAAoC,CAAA,0UAAA;AAalDC,sBAAAD,MAAA,YAAA,IAAL,MAAC;sFAEH,EAAA,eAAA,MAAA,CAAwB,qCACxB,EAAE,MAAM,QAAQ,qCAEhB,EAAA,aAAA,WAAA,SAAA,eAAA,CAA+C,qCAC/C,EAAE,MAAM,KAAK,sBAAS,EAAE,MAAM,KAAK,mCAGnCE,eAAA,EAAE,WAAW,6BACbA,eAAA,EAAE,SAAS,4CACXF,MAAA,YAAA,EAAa,EAAE,aAAa,CAAA,8EAEZA,MAAA,WAAA,EAAY,EAAE,MAAM,CAAA;AAC9B,cAAA,EAAE,QAAM;gDAAE,EAAA,cAAA,WAAA,aAAA,UAAA,SAAA,gBAAmE,CAAA,sCAAA;AAAA;;;uEAOrFG,cAAA,SAAO,EAAE,WAAM,QAAA,KAAkB,EAAE,MAAM,0BAC/BH,MAAA,QAAA,MAAa,EAAE,EAAE,IAAA,cAAA,gEAIvBE,eAAA,EAAE,WAAM,QAAA,sBAAA,kBAAA;;;;AAeb,UAAA,CAAAF,MAAA,OAAA,KAAWA,MAAA,UAAA,IAAU,GAAA;qHACwBA,MAAA,IAAA,KAAI,CAAA,IAAA,cAAA,6FAGhCA,MAAA,IAAA,CAAI,sBAASA,MAAA,UAAA,CAAU,sDAIrCI,sBAAAJ,MAAA,IAAA,KAAQA,MAAA,UAAA,CAAU,IAAA,cAAA;;;;;;;;;;;;;;;","names":["_unref","_ssrRenderList","_ssrInterpolate","_ssrRenderAttr","_ssrIncludeBooleanAttr"],"sources":["../../../../pages/admin/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst { paymentLabel, statusLabel } = useLabels();\n\ntype Row = {\n  id: string;\n  courseTitle: string;\n  startDate: string;\n  paymentMethod: string;\n  status: string;\n  createdAt: string;\n  review: { content: string } | null;\n  user?: {\n    login: string;\n    fullName: string;\n    email: string;\n    phone: string;\n  };\n};\n\nconst { api } = useApi();\nconst toast = useToast();\n\nconst applications = ref<Row[]>([]);\nconst page = ref(1);\nconst limit = ref(8);\nconst total = ref(0);\nconst totalPages = ref(1);\nconst filterStatus = ref<\"\" | \"NEW\" | \"IN_PROGRESS\" | \"COMPLETED\">(\"\");\nconst pending = ref(true);\nconst updating = ref<string | null>(null);\n\ndefinePageMeta({\n  layout: \"default\",\n  middleware: [\"admin\"],\n});\n\nasync function load() {\n  pending.value = true;\n  try {\n    const q: Record<string, string> = {\n      page: String(page.value),\n      limit: String(limit.value),\n    };\n    if (filterStatus.value) q.status = filterStatus.value;\n    const res = await api<{\n      ok: boolean;\n      applications: Row[];\n      total: number;\n      totalPages: number;\n      page: number;\n    }>(\"/api/admin/applications\", { query: q });\n    applications.value = res.applications;\n    total.value = res.total;\n    totalPages.value = res.totalPages;\n    page.value = res.page;\n  } catch {\n    toast.push(\"Не удалось загрузить заявки\", \"error\");\n  } finally {\n    pending.value = false;\n  }\n}\n\nonMounted(load);\n\nwatch([page, filterStatus], () => {\n  void load();\n});\n\nasync function setStatus(id: string, status: string) {\n  updating.value = id;\n  try {\n    await api(`/api/admin/applications/${id}/status`, {\n      method: \"PATCH\",\n      body: { status },\n    });\n    toast.push(\"Статус обновлён\", \"success\");\n    await load();\n  } catch {\n    toast.push(\"Не удалось обновить статус\", \"error\");\n  } finally {\n    updating.value = null;\n  }\n}\n\n/** ТЗ п. 6.3: только перевод в «Идёт обучение» или «Обучение завершено». */\nfunction onAdminStatus(id: string, ev: Event) {\n  const v = (ev.target as HTMLSelectElement).value;\n  if (v === \"IN_PROGRESS\" || v === \"COMPLETED\") void setStatus(id, v);\n}\n\nfunction goPrev() {\n  page.value = Math.max(1, page.value - 1);\n}\n\nfunction goNext() {\n  page.value = Math.min(totalPages.value, page.value + 1);\n}\n</script>\n\n<template>\n  <div>\n    <h1 style=\"margin: 0 0 1rem; font-size: 1.35rem\">\n      Панель администратора\n    </h1>\n\n    <div class=\"toolbar card\" style=\"margin-bottom: 1rem; padding: 1rem\">\n      <div style=\"display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center\">\n        <label style=\"display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; color: var(--muted)\">\n          Фильтр по статусу\n          <select v-model=\"filterStatus\" class=\"filter-select\" @change=\"page = 1\">\n            <option value=\"\">\n              Все\n            </option>\n            <option value=\"NEW\">\n              Новая\n            </option>\n            <option value=\"IN_PROGRESS\">\n              Идёт обучение\n            </option>\n            <option value=\"COMPLETED\">\n              Обучение завершено\n            </option>\n          </select>\n        </label>\n        <span class=\"pill\">Всего: {{ total }}</span>\n      </div>\n    </div>\n\n    <p v-if=\"pending\">\n      Загрузка…\n    </p>\n\n    <div v-else class=\"table-wrap card\" style=\"padding: 0; overflow: hidden\">\n      <table class=\"tbl\">\n        <thead>\n          <tr>\n            <th>Слушатель</th>\n            <th>Курс</th>\n            <th>Старт</th>\n            <th>Оплата</th>\n            <th>Статус</th>\n            <th>Действие</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"a in applications\" :key=\"a.id\">\n            <td>\n              <div style=\"font-weight: 600\">\n                {{ a.user?.fullName }}\n              </div>\n              <div style=\"font-size: 0.85rem; color: var(--muted)\">\n                {{ a.user?.login }} · {{ a.user?.email }}\n              </div>\n            </td>\n            <td>{{ a.courseTitle }}</td>\n            <td>{{ a.startDate }}</td>\n            <td>{{ paymentLabel(a.paymentMethod) }}</td>\n            <td>\n              <span class=\"tag\">{{ statusLabel(a.status) }}</span>\n              <div v-if=\"a.review\" style=\"margin-top: 0.35rem; font-size: 0.8rem; color: var(--muted)\">\n                Есть отзыв\n              </div>\n            </td>\n            <td>\n              <select\n                class=\"mini-select\"\n                :value=\"a.status === 'NEW' ? '' : a.status\"\n                :disabled=\"updating === a.id\"\n                @change=\"onAdminStatus(a.id, $event)\"\n              >\n                <option value=\"\" disabled>\n                  {{ a.status === 'NEW' ? 'Назначить статус…' : 'Изменить статус…' }}\n                </option>\n                <option value=\"IN_PROGRESS\">\n                  Идёт обучение\n                </option>\n                <option value=\"COMPLETED\">\n                  Обучение завершено\n                </option>\n              </select>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div v-if=\"!pending && totalPages > 1\" class=\"pager\">\n      <button type=\"button\" class=\"btn btn-ghost\" :disabled=\"page <= 1\" @click=\"goPrev\">\n        Назад\n      </button>\n      <span class=\"pill\">Стр. {{ page }} / {{ totalPages }}</span>\n      <button\n        type=\"button\"\n        class=\"btn btn-ghost\"\n        :disabled=\"page >= totalPages\"\n        @click=\"goNext\"\n      >\n        Вперёд\n      </button>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.toolbar select,\n.filter-select {\n  padding: 0.45rem 0.65rem;\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: rgba(15, 20, 25, 0.65);\n  color: var(--text);\n  font-family: inherit;\n}\n\n.table-wrap {\n  overflow-x: auto;\n}\n\n.tbl {\n  width: 100%;\n  border-collapse: collapse;\n  min-width: 860px;\n}\n\n.tbl th,\n.tbl td {\n  padding: 0.85rem 1rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  vertical-align: top;\n  text-align: left;\n}\n\n.tbl th {\n  font-size: 0.78rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.mini-select {\n  padding: 0.45rem 0.55rem;\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: rgba(15, 20, 25, 0.65);\n  color: var(--text);\n  font-family: inherit;\n}\n\n.pager {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  margin-top: 1rem;\n}\n\n@media (max-width: 420px) {\n  .tbl {\n    min-width: 720px;\n  }\n}\n</style>\n"],"version":3}